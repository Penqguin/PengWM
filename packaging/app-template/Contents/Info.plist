<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>PengWM</string>
	<key>CFBundleDisplayName</key>
	<string>PengWM</string>
	<key>CFBundleIdentifier</key>
	<string>com.pengwm.daemon</string>
	<!-- Matches the LaunchAgent label (install.sh AGENT_LABEL) so launchd
	     and the bundle agree on the app's identity. -->
	<key>CFBundleVersion</key>
	<string>0.5.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.5.0</string>
	<key>CFBundleExecutable</key>
	<string>pengwm</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconFile</key>
	<string>PengWM</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Background agent: no Dock icon, no main-menu bar. The daemon has no
	     window of its own — its UI surfaces (pengwm-bar, pengwm-menubar) are
	     separate child processes. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>MIT License</string>
</dict>
</plist>
